{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListThisBucketOnly",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::${BUCKET_NAME}"
    },
    {
      "Sid": "ReadDatasetAndScript",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::${BUCKET_NAME}/input/*",
        "arn:aws:s3:::${BUCKET_NAME}/scripts/*"
      ]
    },
    {
      "Sid": "WriteResultsAndLogs",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload"
      ],
      "Resource": [
        "arn:aws:s3:::${BUCKET_NAME}/results/*",
        "arn:aws:s3:::${BUCKET_NAME}/logs/*"
      ]
    }
  ]
}
